---
import Base from "../layouts/Base.astro";
import Meter from "./Meter.astro";
import { credentials, experience, type World } from "../data/worlds";

interface Props {
  world: World;
}
const { world } = Astro.props;
---

<Base world={world}>
  <canvas id="sky" class="sky" aria-hidden="true"></canvas>
  <div id="opening" class="opening-veil" aria-hidden="true"></div>
  <p id="sky-note" class="sky-note" aria-hidden="true"></p>
  <p id="lookback" class="lookback" aria-hidden="true" hidden></p>

  <header class="sp-top">
    <a class="sp-top__name" href={world.path}>Portfolio, 2026</a>
    <nav aria-label="Sections">
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
      <button type="button" class="sound" data-sound data-needs-js aria-pressed="false">Sound off</button>
    </nav>
  </header>

  <main id="main" tabindex="-1">
    <section class="sp-hero">
      <div class="module">
        <button type="button" class="module__button" id="open-console" aria-haspopup="dialog" data-needs-js>
          <Meter value={world.meter} />
          <span class="module__label">
            <span class="module__cta">Change my past</span>
            <span id="module-status">2 other lives to find</span>
          </span>
        </button>
        <p class="sp-hero__what" data-needs-js>
          <span>This number is the timeline you're on, and this one is real. Change one decision from my past and this whole site rewrites itself into the life I'd have had instead.</span>
        </p>
        <noscript>
          <Meter value={world.meter} />
        </noscript>
      </div>
      <div>
        <p class="sp-hero__role"><span>{world.role}</span></p>
        <h1 class="sp-hero__name" data-reveal>{world.name}</h1>
        <p id="sky-hint" class="sp-hero__hint" hidden></p>
      </div>
    </section>

    <section class="sp-section" id="about" aria-labelledby="about-title">
      <h2 class="sp-label" id="about-title"><i>01</i>About</h2>
      {world.about.map((p) => <p class="sp-statement" data-words>{p}</p>)}
    </section>

    <section class="sp-section" id="skills" aria-labelledby="skills-title">
      <h2 class="sp-label" id="skills-title"><i>02</i>Skills</h2>
      <dl class="sp-skills">
        {
          world.skills.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sp-section" id="projects" aria-labelledby="projects-title">
      <h2 class="sp-label" id="projects-title"><i>03</i>Projects</h2>
      <ol>
        {
          world.projects.map((p, i) => (
            <li class="sp-project">
              <p class="sp-project__index">3.{i + 1}</p>
              <h3 data-lines>{p.title}</h3>
              <div class="sp-project__body">
                <div>
                  {p.headline && (
                    <>
                      <p class="sp-big">{p.headline[0]}</p>
                      <p class="sp-big-label">{p.headline[1]}</p>
                    </>
                  )}
                </div>
                <div class="sp-project__text">
                  <p>{p.summary}</p>
                  <dl class="spec spec--small">
                    {p.specs.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  {p.links && (
                    <p class="project__links">
                      {p.links.map(([label, href]) => (
                        <a href={href} rel="noopener">{label}</a>
                      ))}
                    </p>
                  )}
                </div>
              </div>
              {p.how && (
                <dl class="sp-how">
                  {p.how.map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                  {p.limits && (
                    <div class="sp-how__limits">
                      <dt>Limits</dt>
                      <dd>{p.limits}</dd>
                    </div>
                  )}
                  {p.stack && (
                    <div>
                      <dt>Built with</dt>
                      <dd>{p.stack}</dd>
                    </div>
                  )}
                </dl>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sp-section" id="experience" aria-labelledby="experience-title">
      <h2 class="sp-label" id="experience-title"><i>04</i>Experience</h2>
      <ol class="sp-jobs">
        {
          experience.map((job) => (
            <li>
              <p class="sp-jobs__when">{job.when}</p>
              <h3>{job.place}</h3>
              <p class="sp-jobs__role">{job.role}</p>
              <p class="sp-jobs__detail">{job.detail}</p>
            </li>
          ))
        }
      </ol>
      <dl class="sp-how sp-credentials">
        {
          credentials.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sp-section" id="contact" aria-labelledby="contact-title">
      <h2 class="sp-label" id="contact-title"><i>05</i>Contact</h2>
      <ul class="sp-contact">
        <li><a href="mailto:shahesta0028@gmail.com">shahesta0028@gmail.com</a></li>
        <li><a href="https://github.com/S2800-0" rel="noopener">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/shahesta-salama-396566320/" rel="noopener">LinkedIn</a></li>
        <li><a href="/shahesta-salama-cv.pdf">CV (PDF)</a></li>
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>Hosted on AWS Amplify. {import.meta.env.PUBLIC_COUNTER_URL && "The counter in the console runs on AWS Lambda and DynamoDB. "}Hubble Ultra Deep Field: NASA/ESA. Point at it and the light bends. The time machine is a fan homage, not affiliated with the rights holders of anything.</p>
  </footer>
</Base>
